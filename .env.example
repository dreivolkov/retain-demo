# Live Paddle client-side token — used for all three Retain demo flows
# (paymentRecovery, paymentRecoveryInApp, cancellationFlow) via Paddle.Retain.demo().
# Must be a live token; Retain does not work with sandbox accounts.
# The domain this app is served from must be allowlisted in the Paddle dashboard.
# A Cancellation Flow must be configured under Paddle > Retain > Cancellation Flows.
NEXT_PUBLIC_PADDLE_LIVE_TOKEN=

# Optional: path to a local Chrome/Chromium executable for the screenshot API in dev.
# Leave blank on Vercel — the serverless Chromium bundle is used automatically.
# Example: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
CHROME_EXECUTABLE_PATH=
