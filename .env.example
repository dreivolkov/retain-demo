# Sandbox client-side token, used only for the visual Checkout overlay in the
# Payment Recovery / Payment Recovery In-App demos. Not tied to real Retain dunning.
NEXT_PUBLIC_PADDLE_SANDBOX_TOKEN=

# A sandbox price ID to open in that checkout overlay.
NEXT_PUBLIC_PADDLE_SANDBOX_PRICE_ID=

# Live client-side token, used only on the Cancellation Flow demo page to call
# Paddle.Retain.demo({ feature: 'cancellationFlow' }). Retain only works with live
# data, so this must be a live token, and the domain this app is served from
# (including localhost, if permitted) must be allowlisted in the Paddle dashboard.
# A Cancellation Flow must already be configured under Paddle > Retain.
NEXT_PUBLIC_PADDLE_LIVE_TOKEN=

# Optional: path to a local Chrome/Chromium executable, used by the screenshot API
# in local dev instead of downloading the serverless Chromium bundle. e.g. on macOS:
# /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
CHROME_EXECUTABLE_PATH=
